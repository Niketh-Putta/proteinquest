{
  "expo": {
    "name": "ProteinQuest",
    "slug": "proteinquest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "proteinquest",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C0B10",
    "ios": {
      "bundleIdentifier": "com.proteinquest.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "ProteinQuest uses the camera to photograph your meals and estimate their protein content.",
        "NSPhotoLibraryUsageDescription": "ProteinQuest uses your photo library so you can analyze meals you've already photographed.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.proteinquest.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0C0B10",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C0B10",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "ProteinQuest uses the camera to photograph your meals and estimate their protein content.",
          "photosPermission": "ProteinQuest uses your photo library so you can analyze meals you've already photographed."
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
