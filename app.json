{
  "expo": {
    "name": "ProteinQuest - Protein Tracker",
    "slug": "proteinquest",
    "version": "1.0.34",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "proteinquest",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C0B10",
    "ios": {
      "bundleIdentifier": "com.proteinquest.app",
      "buildNumber": "75",
      "supportsTablet": true,
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "CFBundleDisplayName": "ProteinQuest - Protein Tracker",
        "NSCameraUsageDescription": "ProteinQuest uses the camera to photograph your meals, read barcodes, and estimate protein content.",
        "NSPhotoLibraryUsageDescription": "ProteinQuest uses your photo library so you can analyze meals you've already photographed.",
        "NSUserNotificationsUsageDescription": "ProteinQuest sends friendly reminders to log meals and feed your dragon.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSMinimumSystemVersion": "12.0"
      }
    },
    "android": {
      "package": "com.proteinquest.app",
      "adaptiveIcon": {
        "backgroundColor": "#0C0B10",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "com.android.vending.BILLING",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "versionCode": 131
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "ProteinQuest uses the camera to photograph your meals, read barcodes, and estimate protein content.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C0B10",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0C0B10",
            "image": "./assets/images/splash-logo.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "ProteinQuest uses the camera to photograph your meals and estimate their protein content.",
          "photosPermission": "ProteinQuest uses your photo library so you can analyze meals you've already photographed."
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-video",
      "expo-image",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FF7A59"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "246d88eb-db0c-4937-a681-653a2b7c53fa"
      },
      "supabaseUrl": "https://csxdkvpvcasuknhnprxp.supabase.co",
      "supabaseKey": "sb_publishable_Zg6Jj70nqJcd7OGof5iP6w_9My7yS9F",
      "revenueCatIosKey": "appl_KODNDDCOzElyVFNlBBZkYQZjtxH",
      "revenueCatAndroidKey": "goog_pBfqlzoHuwkGyuMtFQGqArwkSfl"
    },
    "owner": "nikethputta1"
  }
}
