# Supabase (required)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-anon-key

# Stripe web checkout (optional — set true when Supabase secrets are configured)
EXPO_PUBLIC_STRIPE_ENABLED=false

# RevenueCat native IAP (optional — get from RevenueCat dashboard → Project → API keys)
# Use platform-specific PUBLIC keys, not secret keys.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your_ios_public_sdk_key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your_android_public_sdk_key
