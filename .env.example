# Supabase (required)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-anon-key

# RevenueCat native IAP (required for real Play/App Store purchases)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your_ios_public_key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your_android_public_key

# Stripe web checkout (optional — web only)
EXPO_PUBLIC_STRIPE_ENABLED=false

# EAS / deploy (optional locally)
EXPO_TOKEN=
VERCEL_TOKEN=

# Private download stats dashboard (/pqx-stats-k7m2n9)
STATS_ACCESS_TOKEN=
APPLE_VENDOR_NUMBER=
ASC_KEY_P8=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_GCS_BUCKET=

# GoDaddy DNS automation (optional — for npm run dns:update)
GODADDY_API_KEY=
GODADDY_API_SECRET=
